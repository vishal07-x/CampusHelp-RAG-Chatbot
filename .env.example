# ==========================================
# CampusHelp RAG System Configuration
# ==========================================

# 1. Environment & API
ENV=development
DEBUG=true
PORT=8000

# 2. Database Configuration
# For local development without Docker, use SQLite (leave blank or use sqlite:///./campushelp.db)
# For production or Docker Compose, use PostgreSQL
DATABASE_URL=sqlite:///./campushelp.db
# DATABASE_URL=postgresql://campus_user:campus_secure_password_2026@localhost:5432/campushelp

# 3. Security & Authentication
SECRET_KEY=campushelp_super_secure_jwt_secret_key_change_in_production_2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_DEFAULT_EMAIL=admin@campushelp.edu
ADMIN_DEFAULT_PASSWORD=Admin@CampusHelp2026!

# 4. Qdrant Vector Database
# For remote or Docker Qdrant, specify QDRANT_URL
# QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=campus_documents

# 5. AI / LLM & Embeddings Configuration
# Provide your OpenAI API Key for real-time GPT-4o-mini generation and text-embedding-3-small
OPENAI_API_KEY=your-openai-api-key-here

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# 6. RAG Pipeline Tuning Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_CANDIDATES=10
RERANK_TOP_K=4

# 7. Upload Constraints
MAX_FILE_SIZE_MB=20
